{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"urn:v4:sdk-readonly:1",
 "title":"B3a independent SDK readonly wire candidate, not adopted AGT028",
 "description":"LF-delimited strict UTF8. Lexical codecs additionally reject duplicate decoded keys, BOM, lone surrogates, decimal/exponent numbers and unsafe integers. No resume/cancel/batch/bulk/snapshot. Stateful direction, sequence and request correlation are mandatory.",
 "x-limits":{"frame_bytes_including_lf":262144,"direction_bytes":8388608,"direction_frames":256,"json_depth":32,"stderr_bytes":262144,"handshake_seconds":3,"partial_frame_seconds_absolute":5,"session_seconds":45},
 "type":"object","additionalProperties":false,
 "required":["protocol","nonce","run_id","epoch","seq","type","reply_to","body"],
 "properties":{
  "protocol":{"const":"v4.sdk-readonly/1"},
  "nonce":{"type":"string","pattern":"^[0-9a-f]{32}$"},
  "run_id":{"$ref":"#/$defs/id"},
  "epoch":{"type":"string","pattern":"^(0|[1-9][0-9]{0,29})$"},
  "seq":{"type":"integer","minimum":1,"maximum":256},
  "type":{"enum":["hello","ready","start","request","response","session_end","error"]},
  "reply_to":{"type":["integer","null"],"minimum":1,"maximum":256},"body":{}
 },
 "allOf":[
  {"if":{"properties":{"type":{"enum":["hello","ready"]}}},"then":{"properties":{"body":{"$ref":"#/$defs/handshake"},"reply_to":{"type":"null"}}}},
  {"if":{"properties":{"type":{"const":"start"}}},"then":{"properties":{"body":{"$ref":"#/$defs/start"},"reply_to":{"type":"null"}}}},
  {"if":{"properties":{"type":{"const":"request"}}},"then":{"properties":{"body":{"$ref":"#/$defs/request"},"reply_to":{"type":"null"}}}},
  {"if":{"properties":{"type":{"const":"response"}}},"then":{"properties":{"body":{"$ref":"#/$defs/response"},"reply_to":{"type":"integer"}}}},
  {"if":{"properties":{"type":{"const":"session_end"}}},"then":{"properties":{"body":{"type":"object","additionalProperties":false,"required":["status"],"properties":{"status":{"enum":["ok","error"]}}},"reply_to":{"type":"null"}}}},
  {"if":{"properties":{"type":{"const":"error"}}},"then":{"properties":{"body":{"type":"object","additionalProperties":false,"required":["code"],"properties":{"code":{"$ref":"#/$defs/code"}}},"reply_to":{"type":"null"}}}}
 ],
 "$defs":{
  "id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9_.:-]+$"},
  "safeint":{"type":"integer","minimum":0,"maximum":9007199254740991},
  "code":{"enum":["host_operation_failed","protocol_error","runtime_failed"]},
  "sdk":{"type":"object","additionalProperties":false,"required":["engine","version","adapter_contract"],"properties":{"engine":{"const":"@earendil-works/pi-coding-agent"},"version":{"const":"1.4.0"},"adapter_contract":{"const":"host-run-receipt-v1"}}},
  "handshake":{"type":"object","additionalProperties":false,"required":["sdk","profile"],"properties":{"sdk":{"$ref":"#/$defs/sdk"},"profile":{"const":"tasks.list_mine@1"}}},
  "start":{"type":"object","additionalProperties":false,"required":["tool_name","input_schema","prompt"],"properties":{"tool_name":{"const":"tasks.list_mine@1"},"input_schema":{"type":"object"},"prompt":{"type":"string","minLength":1,"maxLength":8000}}},
  "message":{"type":"object","additionalProperties":false,"required":["role","content","usage","stopReason"],"properties":{"role":{"const":"assistant"},"content":{"type":"array"},"stopReason":{"enum":["toolUse","stop"]},"usage":{"type":"object","additionalProperties":false,"required":["input","output"],"properties":{"input":{"$ref":"#/$defs/safeint"},"output":{"$ref":"#/$defs/safeint"}}}}},
  "request":{"oneOf":[
   {"type":"object","additionalProperties":false,"required":["op","arguments"],"properties":{"op":{"const":"model_begin"},"arguments":{"type":"object","additionalProperties":false,"required":["input_digest"],"properties":{"input_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}},
   {"type":"object","additionalProperties":false,"required":["op","arguments"],"properties":{"op":{"const":"model_complete"},"arguments":{"type":"object","additionalProperties":false,"required":["permit","step_id","message"],"properties":{"permit":{"$ref":"#/$defs/id"},"step_id":{"$ref":"#/$defs/id"},"message":{"$ref":"#/$defs/message"}}}}},
   {"type":"object","additionalProperties":false,"required":["op","arguments"],"properties":{"op":{"const":"tool_request"},"arguments":{"type":"object","additionalProperties":false,"required":["call_id","arguments"],"properties":{"call_id":{"type":"string","minLength":1,"maxLength":100,"pattern":"^[A-Za-z0-9_.:-]+$"},"arguments":{"type":"object"}}}}}
  ]},
  "response":{"type":"object","additionalProperties":false,"required":["op","ok","result","code"],"properties":{"op":{"enum":["model_begin","model_complete","tool_request"]},"ok":{"type":"boolean"},"result":{},"code":{}},"allOf":[{"if":{"properties":{"ok":{"const":true}}},"then":{"properties":{"result":{"type":"object"},"code":{"type":"null"}}},"else":{"properties":{"result":{"type":"null"},"code":{"$ref":"#/$defs/code"}}}}]}
 }
}
