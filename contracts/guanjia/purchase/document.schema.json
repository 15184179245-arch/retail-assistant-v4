{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retail.example.invalid/contracts/guanjia/purchase/document.schema.json",
  "title": "PUR-003 employee attestation of a claimed Guanjia purchase document",
  "description": "LOCAL HUMAN CLAIM DTO; not a Guanjia REST request/response or verified purchase order.",
  "type": "object",
  "additionalProperties": false,
  "x-real-erp-read-verified": false,
  "x-erp-write-enabled": false,
  "x-erp-contract-endpoint": null,
  "x-permission-gates": [
    "receiving.read",
    "receiving.review",
    "purchasing.read"
  ],
  "x-status": "manual_attested_unverified",
  "required": [
    "document_kind",
    "claimed_document_no",
    "evidence_type",
    "evidence_sha256",
    "source_observed_at",
    "currency",
    "total_amount",
    "lines",
    "human_checked",
    "note",
    "previous_receipt_digest"
  ],
  "properties": {
    "document_kind": {
      "type": "string",
      "enum": [
        "purchase_order",
        "goods_receipt"
      ],
      "description": "Employee's claim of document type, not proof of posted inventory."
    },
    "claimed_document_no": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,79}$"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "erp_screen_view",
        "erp_paper_document"
      ]
    },
    "evidence_sha256": {
      "$ref": "#/$defs/digest"
    },
    "source_observed_at": {
      "$ref": "#/$defs/awareTime"
    },
    "currency": {
      "type": "string",
      "const": "CNY"
    },
    "total_amount": {
      "oneOf": [
        {
          "$ref": "#/$defs/money"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null when no actual unit prices evidenced; never inferred from purchase intent."
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_key",
          "product_id",
          "unit",
          "quantity",
          "unit_price",
          "line_total",
          "source_line_sha256"
        ],
        "properties": {
          "line_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "product_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "quantity": {
            "$ref": "#/$defs/money"
          },
          "unit_price": {
            "oneOf": [
              {
                "$ref": "#/$defs/money"
              },
              {
                "type": "null"
              }
            ]
          },
          "line_total": {
            "oneOf": [
              {
                "$ref": "#/$defs/money"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_line_sha256": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "human_checked": {
      "const": true
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "previous_receipt_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "awareTime": {
      "type": "string",
      "format": "date-time",
      "description": "UTC offset required"
    },
    "money": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,4})?$",
      "maxLength": 40
    }
  },
  "examples": [
    {
      "document_kind": "purchase_order",
      "claimed_document_no": "SYN-PO-001",
      "evidence_type": "erp_screen_view",
      "evidence_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "source_observed_at": "2026-10-26T01:00:00Z",
      "currency": "CNY",
      "total_amount": null,
      "lines": [
        {
          "line_key": "synthetic-line",
          "product_id": "synthetic-product",
          "unit": "piece",
          "quantity": "2",
          "unit_price": null,
          "line_total": null,
          "source_line_sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        }
      ],
      "human_checked": true,
      "note": "人工对照合成源截图，尚未由ERP授权读回执独立证明",
      "previous_receipt_digest": null
    }
  ]
}
