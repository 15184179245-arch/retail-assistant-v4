          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "tools": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/online_tool"
          }
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        }
