      "properties": {
        "protocol": {
          "const": "v4.pi-discovery/2"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "run_id": {
          "$ref": "#/$defs/online_id"
        },
        "epoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,29})$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "type": {
          "enum": [
            "hello",
            "ready",
            "start",
            "request",
            "response",
            "session_end",
            "error"
          ]
        },
        "reply_to": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 256
        },
        "body": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "hello",
                  "ready"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/online_handshake"
              },
              "reply_to": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "start"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/online_start"
              },
              "reply_to": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "request"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/online_request"
              },
              "reply_to": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "response"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/online_response"
              },
              "reply_to": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "session_end"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "type": "object",
