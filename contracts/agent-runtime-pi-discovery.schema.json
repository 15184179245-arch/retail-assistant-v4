          "enum": [
            "toolUse",
            "stop",
            "error",
            "aborted"
          ]
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "output",
            "cacheRead",
            "cacheWrite"
          ],
          "properties": {
            "input": {
              "$ref": "#/$defs/online_safeint"
            },
            "output": {
              "$ref": "#/$defs/online_safeint"
            },
            "cacheRead": {
              "$ref": "#/$defs/online_safeint"
            },
            "cacheWrite": {
              "$ref": "#/$defs/online_safeint"
            }
          }
        }
      }
    },
    "online_request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "arguments"
          ],
          "properties": {
