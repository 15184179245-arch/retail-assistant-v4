                "properties": {
                  "status": {
                    "enum": [
                      "ok",
                      "error"
                    ]
                  }
                }
              },
              "reply_to": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "error"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "$ref": "#/$defs/online_code"
                  }
                }
              },
              "reply_to": {
                "type": "null"
              }
            }
          }
        }
      ],
      "x-stateful-requirements": [
        "exact role/direction and next sequence",
        "same nonce/run/epoch",
        "single pending request and matching reply_to/op",
