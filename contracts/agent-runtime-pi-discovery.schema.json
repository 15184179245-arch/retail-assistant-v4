          "enum": [
            "v4_tasks_list_mine_v1",
            "v4_knowledge_search_v1",
            "v4_catalog_search_v1",
            "v4_memory_search_v1",
            "v4_memory_save_v1",
            "v4_memory_correct_v1",
            "v4_memory_withdraw_v1",
            "tool_search"
          ]
        },
        "version": {
          "const": "1"
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "online_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "online_safeint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "online_code": {
      "enum": [
        "host_operation_failed",
        "protocol_error",
        "runtime_failed"
      ]
    },
    "online_sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "version",
