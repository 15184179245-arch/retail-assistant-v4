                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "toolset_version": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "request_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "arguments"
          ],
          "properties": {
            "op": {
              "const": "model_complete"
            },
            "arguments": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt_id",
                "permit",
                "step_id",
                "message"
              ],
              "properties": {
                "attempt_id": {
                  "$ref": "#/$defs/online_id"
                },
                "permit": {
                  "$ref": "#/$defs/online_id"
                },
                "step_id": {
                  "$ref": "#/$defs/online_id"
                },
                "message": {
                  "$ref": "#/$defs/online_message"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "arguments"
          ],
          "properties": {
            "op": {
              "const": "tool_request"
            },
            "arguments": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "call_id",
                "name",
                "version",
                "toolset_version",
                "arguments"
              ],
              "properties": {
                "call_id": {
                  "$ref": "#/$defs/online_native_id"
                },
                "name": {
                  "enum": [
                    "v4_tasks_list_mine_v1",
                    "v4_knowledge_search_v1",
                    "v4_catalog_search_v1",
                    "v4_memory_search_v1",
                    "v4_memory_save_v1",
                    "v4_memory_correct_v1",
                    "v4_memory_withdraw_v1",
                    "tool_search"
                  ]
                },
                "version": {
                  "const": "1"
                },
                "toolset_version": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
