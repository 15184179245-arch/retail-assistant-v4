            },
            "arguments": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt_id",
                "step_id",
                "permit",
                "input_digest",
                "request",
                "request_digest"
              ],
              "properties": {
                "attempt_id": {
                  "$ref": "#/$defs/id"
                },
                "step_id": {
                  "$ref": "#/$defs/id"
                },
