{
  "name": "@retail/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Host-authorized Pi read-only IPC runtime; recovery A only",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": "11.9.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "npm run prepare:types && tsc -p tsconfig.json",
    "typecheck": "npm run prepare:types && tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "prepare:types": "node scripts/prepare-pi-declarations.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "ajv": "8.17.1",
    "typebox": "1.3.27",
    "@modelcontextprotocol/sdk": "1.25.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
